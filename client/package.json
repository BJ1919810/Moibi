{
  "name": "mobi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "墨笔 · AI 长篇小说创作坊（手机端 PWA / APK）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:app": "vite build --mode app",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "test": "node --test --import ./tests/_isolate.mjs",
    "cap:sync": "cap sync android",
    "apk:debug": "npm run build:app && cap sync android && node scripts/build-apk.mjs debug",
    "apk:release": "npm run build:app && cap sync android && node scripts/build-apk.mjs release",
    "verify:back": "node scripts/verify-back-key.mjs",
    "verify:back:web": "vite build --outDir dist-web-verify --emptyOutDir && node scripts/verify-back-key-web.mjs",
    "verify:autofill": "node scripts/verify-create-autofill.mjs",
    "verify:nav": "npm run build && node scripts/verify-nav-direction.mjs",
    "verify:replan": "node scripts/verify-replan-window.mjs",
    "verify:replan:real": "node scripts/verify-replan-real-project.mjs",
    "verify:reveal": "node scripts/verify-reveal-approval.mjs",
    "verify:reveal:ui": "npm run build && node scripts/verify-reveal-approval-ui.mjs",
    "verify:reader": "npm run build && node scripts/verify-reader-taps.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
